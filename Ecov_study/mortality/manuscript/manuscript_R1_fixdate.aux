\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Classification trees indicating primary factors determining convergence as defined by providing Hessian-based standard errors for operating models (OMs) with process error on recruitment only (R), recruitment and apparent survival (R+S), or recruitment and natural mortality (R+M). Nodes denote percent convergence (top) and number of fits (bottom) for the corresponding subset. Lower or higher convergence rates are indicated by more red or green polygons, respectively. See Table \ref {factor_table} for description of OM and EM factors defining nodes and branches.}}{40}{figure.caption.36}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{conv_class}{{1}{40}{Classification trees indicating primary factors determining convergence as defined by providing Hessian-based standard errors for operating models (OMs) with process error on recruitment only (R), recruitment and apparent survival (R+S), or recruitment and natural mortality (R+M). Nodes denote percent convergence (top) and number of fits (bottom) for the corresponding subset. Lower or higher convergence rates are indicated by more red or green polygons, respectively. See Table \ref {factor_table} for description of OM and EM factors defining nodes and branches}{figure.caption.36}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Classification trees indicating primary factors determining which process error assumption in estimating models (EMs) provides the lowest AIC for operating models (OMs) with process error on recruitment only (R), recruitment and apparent survival (R+S), or recruitment and natural mortality (R+M). Each node shows the percentage of EM fits with a given process error assumption having the lowest AIC and the number of observations for the corresponding subset of fits. Lower or higher accuracy of the process error assumption are indicated by more red or green polygons, respectively. See Table \ref {factor_table} for description of OM and EM factors defining nodes and branches.}}{41}{figure.caption.37}\protected@file@percent }
\newlabel{AIC_PE_class}{{2}{41}{Classification trees indicating primary factors determining which process error assumption in estimating models (EMs) provides the lowest AIC for operating models (OMs) with process error on recruitment only (R), recruitment and apparent survival (R+S), or recruitment and natural mortality (R+M). Each node shows the percentage of EM fits with a given process error assumption having the lowest AIC and the number of observations for the corresponding subset of fits. Lower or higher accuracy of the process error assumption are indicated by more red or green polygons, respectively. See Table \ref {factor_table} for description of OM and EM factors defining nodes and branches}{figure.caption.37}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Classification trees indicating primary factors determining whether the correct EM assumption for covariate effect on $M$ (no effect with OM $\beta _E = 0$ or estimated effect when OM $\beta _E > 0$) provides the lowest AIC for OMs assuming values for $\beta _E$ of 0, 0.25, and 0.5. Nodes denote the percentage of estimating models (EMs) with correct assumption and lowest AIC (top), and number of observations (bottom) for the corresponding subset. Lower or higher accuracy of the process error assumption are indicated by more red or green polygons, respectively. See Table \ref {factor_table} for description of OM and EM factors defining nodes and branches.}}{42}{figure.caption.38}\protected@file@percent }
\newlabel{AIC_Ecov_effect_class}{{3}{42}{Classification trees indicating primary factors determining whether the correct EM assumption for covariate effect on $M$ (no effect with OM $\beta _E = 0$ or estimated effect when OM $\beta _E > 0$) provides the lowest AIC for OMs assuming values for $\beta _E$ of 0, 0.25, and 0.5. Nodes denote the percentage of estimating models (EMs) with correct assumption and lowest AIC (top), and number of observations (bottom) for the corresponding subset. Lower or higher accuracy of the process error assumption are indicated by more red or green polygons, respectively. See Table \ref {factor_table} for description of OM and EM factors defining nodes and branches}{figure.caption.38}{}}
