\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Classification trees indicating primary factors determining convergence as defined by providing Hessian-based standard errors for operating models (OMs) with process error on recruitment only (R), recruitment and apparent survival (R+S), or recruitment and natural mortality (R+M). Nodes denote percent convergence (top) and number of fits (bottom) for the corresponding subset. Lower or higher convergence rates are indicated by more red or green polygons, respectively. See Table S1 for description of OM and estimating model (EM) factors defining nodes and branches.}}{24}{figure.caption.39}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{conv_class}{{1}{24}{Classification trees indicating primary factors determining convergence as defined by providing Hessian-based standard errors for operating models (OMs) with process error on recruitment only (R), recruitment and apparent survival (R+S), or recruitment and natural mortality (R+M). Nodes denote percent convergence (top) and number of fits (bottom) for the corresponding subset. Lower or higher convergence rates are indicated by more red or green polygons, respectively. See Table S1 for description of OM and estimating model (EM) factors defining nodes and branches}{figure.caption.39}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Classification trees for which estimating model process error assumption provides the lowest AIC. Each node shows the percentages (if greater than 10\%) of estimating model fits with a given process error assumption having the lowest AIC for the corresponding subset. Process error assumptions with percentages less than 10\% are grouped as ``other.'' Lower or higher accuracy are indicated by more red or green polygons, respectively. See Figure \ref {conv_class} caption and Table S1 for further details.}}{25}{figure.caption.40}\protected@file@percent }
\newlabel{AIC_PE_class}{{2}{25}{Classification trees for which estimating model process error assumption provides the lowest AIC. Each node shows the percentages (if greater than 10\%) of estimating model fits with a given process error assumption having the lowest AIC for the corresponding subset. Process error assumptions with percentages less than 10\% are grouped as ``other.'' Lower or higher accuracy are indicated by more red or green polygons, respectively. See Figure \ref {conv_class} caption and Table S1 for further details}{figure.caption.40}{}}
