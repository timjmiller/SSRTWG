\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Classification trees indicating primary factors determining convergence as defined by providing Hessian-based standard errors for operating models (OMs) with process error on recruitment only (R), recruitment and apparent survival (R+S), or recruitment and natural mortality (R+M). Nodes denote percent convergence (top) and number of fits (bottom) for the corresponding subset. Lower or higher convergence rates are indicated by more red or green polygons, respectively. See Table \ref {factor_table} for description of OM and estimating model (EM) factors defining nodes and branches.}}{36}{figure.caption.36}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{conv_class}{{1}{36}{Classification trees indicating primary factors determining convergence as defined by providing Hessian-based standard errors for operating models (OMs) with process error on recruitment only (R), recruitment and apparent survival (R+S), or recruitment and natural mortality (R+M). Nodes denote percent convergence (top) and number of fits (bottom) for the corresponding subset. Lower or higher convergence rates are indicated by more red or green polygons, respectively. See Table \ref {factor_table} for description of OM and estimating model (EM) factors defining nodes and branches}{figure.caption.36}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Classification trees for which estimating model process error assumption provides the lowest AIC. Each node shows the percentages (if greater than 10\%) of estimating model fits with a given process error assumption having the lowest AIC for the corresponding subset. Process error assumptions with percentages less than 10\% are grouped as ``other.'' Lower or higher accuracy are indicated by more red or green polygons, respectively. See Figure \ref {conv_class} caption and Table \ref {factor_table} for further details.}}{37}{figure.caption.37}\protected@file@percent }
\newlabel{AIC_PE_class}{{2}{37}{Classification trees for which estimating model process error assumption provides the lowest AIC. Each node shows the percentages (if greater than 10\%) of estimating model fits with a given process error assumption having the lowest AIC for the corresponding subset. Process error assumptions with percentages less than 10\% are grouped as ``other.'' Lower or higher accuracy are indicated by more red or green polygons, respectively. See Figure \ref {conv_class} caption and Table \ref {factor_table} for further details}{figure.caption.37}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Classification trees for whether the correct estimating model assumption for covariate effect on $M$ (no effect with OM $\beta _E = 0$ or estimated effect when OM $\beta _E > 0$) provides the lowest AIC for OMs assuming values for $\beta _E$ of 0, 0.25, and 0.5. Nodes denote the percentage of estimating models with the correct assumption and lowest AIC for the corresponding subset. Lower or higher accuracy are indicated by more red or green polygons, respectively. See Figure \ref {conv_class} caption and Table \ref {factor_table} for further details.}}{38}{figure.caption.38}\protected@file@percent }
\newlabel{AIC_Ecov_effect_class}{{3}{38}{Classification trees for whether the correct estimating model assumption for covariate effect on $M$ (no effect with OM $\beta _E = 0$ or estimated effect when OM $\beta _E > 0$) provides the lowest AIC for OMs assuming values for $\beta _E$ of 0, 0.25, and 0.5. Nodes denote the percentage of estimating models with the correct assumption and lowest AIC for the corresponding subset. Lower or higher accuracy are indicated by more red or green polygons, respectively. See Figure \ref {conv_class} caption and Table \ref {factor_table} for further details}{figure.caption.38}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Regression trees for estimation error of the median $M$ parameter ($\beta _M$). Each node shows the median error for the corresponding subset. Lower or higher absolute median errors are indicated by more green or red polygons, respectively. See Figure \ref {conv_class} caption and Table \ref {factor_table} for further details.}}{39}{figure.caption.39}\protected@file@percent }
\newlabel{med_M_bias_regtree}{{4}{39}{Regression trees for estimation error of the median $M$ parameter ($\beta _M$). Each node shows the median error for the corresponding subset. Lower or higher absolute median errors are indicated by more green or red polygons, respectively. See Figure \ref {conv_class} caption and Table \ref {factor_table} for further details}{figure.caption.39}{}}
